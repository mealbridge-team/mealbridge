# Google AI Studio key (free tier). Enables Gemini for the agents.
GOOGLE_GENERATIVE_AI_API_KEY=
# Flash reads photos; Flash-Lite writes explanations and runs the dashboard agents.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Requests per minute we allow ourselves per model (free tier: about 5 for Flash, 15 for Flash-Lite).
# GEMINI_RPM=5
# GEMINI_FAST_RPM=14
# Daily cap on Gemini calls; past it the agents fall back to rules. Protects the free quota.
# GEMINI_DAILY_LIMIT=400

# AG Studio trial licence for the impact dashboard (without it, Studio shows a trial watermark).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Shelters keep evening hours; the public demo checks them on a "demo evening" clock so it works at
# any hour. Set to off to use real hours.
# DEMO_EVENING=on

# Public demo: coordinator actions (approve payouts, cancel, reset) need this passcode.
# Leave empty locally to keep everything open.
DEMO_PASSCODE=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# Postgres connection string (Render Postgres). Leave empty to use embedded PGlite in .data/.
DATABASE_URL=

# Sandbox personal accounts that receive driver payouts in the demo.
DEMO_DRIVER_1_EMAIL=
DEMO_DRIVER_2_PHONE=
DEMO_DRIVER_3_EMAIL=
# Sandbox personal account that receives sponsor invoices (PayPal Invoicing).
DEMO_SPONSOR_EMAIL=
