# Copy to .env.local. Everything is optional: without keys the app runs in a clearly
# labelled demo mode (mock PayPal, rule-based intake) on an embedded database.

# Google AI Studio key (free tier). Enables Gemini for the agents.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials, Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# Postgres connection string (Render Postgres). Leave empty to use embedded PGlite in .data/.
DATABASE_URL=

# Sandbox personal accounts that receive driver payouts in the demo.
DEMO_DRIVER_1_EMAIL=
DEMO_DRIVER_2_PHONE=
DEMO_DRIVER_3_EMAIL=
